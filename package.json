{
  "name": "@stngcoding/tissues",
  "version": "0.3.0",
  "description": "Terminal UI for browsing and triaging the current repo's GitHub issues",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "tissues": "src/index.ts"
  },
  "files": [
    "src",
    "bunfig.toml",
    "docs/adr",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@opentui/core": "0.4.5",
    "marked": "17.0.1",
    "web-tree-sitter": "0.25.10"
  }
}
